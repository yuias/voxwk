<?xml version="1.0" encoding="utf-8"?>
<!-- Only the settings and the session history are backed up. The models are
     large and can be downloaded again; the API keys and their Tink keyset are
     bound to this device's Keystore and cannot be restored elsewhere. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="sessions/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="sessions/" />
    </device-transfer>
</data-extraction-rules>
