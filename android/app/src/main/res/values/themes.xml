<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Window theme of the app; its light/dark variant is picked by the system from the first frame. -->
    <style name="Theme.Voxwk" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.Voxwk.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F4FBFA</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#006A6A</item>
        <item name="postSplashScreenTheme">@style/Theme.Voxwk</item>
    </style>
</resources>
